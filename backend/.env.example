# ===================================================
# SECURE GEOTAGGED EVIDENCE SYSTEM - Environment Config
# ===================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="GioTag Evidence System"
APP_VERSION=1.0.0

# --- Database ---
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://giotag:giotag_secret@localhost:5432/giotag_db

# SQLite fallback (for quick local dev without PostgreSQL)
# DATABASE_URL=sqlite:///./giotag.db

# --- Security ---
SECRET_KEY=changeme-super-secret-jwt-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Storage ---
# Options: local | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# Supabase (only if STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=evidence-images

# --- AI Service ---
AI_ENABLED=true
# Options: opencv | pytorch | mock
AI_MODEL_TYPE=opencv
AI_MODEL_PATH=

# --- OpenAI Vision (Egg & Tray Counting) ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Options: openai | yolo
DETECTOR_PROVIDER=openai
OPENAI_MAX_IMAGE_SIZE_MB=20

# --- Blockchain ---
# Options: local | ethereum | polygon
BLOCKCHAIN_MODE=local
LOCAL_LEDGER_PATH=./app/blockchain/ledger_data.json

# Ethereum/Polygon (only if BLOCKCHAIN_MODE=ethereum|polygon)
WEB3_PROVIDER_URL=
CONTRACT_ADDRESS=
CHAIN_ID=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- File Upload ---
MAX_FILE_SIZE_MB=15
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- GPS ---
GPS_ACCURACY_THRESHOLD_METERS=50

# --- Demo / Seed ---
# Set to true to seed demo data on first startup
SEED_DEMO_DATA=true
